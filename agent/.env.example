# Gemini Enterprise
GOOGLE_CLOUD_PROJECT=project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-flash-latest

# External MCP Servers (Layer 2 — localhost during dev, Cloud Run during demo)
CONTEXT_SERVER_URL=http://localhost:8080
BROKER_URL=http://localhost:8081
CICD_SERVER_URL=http://localhost:8082

# Agent settings
AGENT_PORT=3000
LOG_LEVEL=INFO
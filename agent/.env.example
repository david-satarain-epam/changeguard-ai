# Model provider: use Gemini API when false, Vertex AI when true.
MODEL=gemini-3.6-flash
GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY=replace-with-a-secret
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-east1

# Secure Broker MCP endpoint. The agent never calls CICD directly.
BROKER_MCP_URL=http://localhost:8080/mcp

# Execution mode after explicit user approval: mock | live
LAYER_MODE=live

# Agent settings
AGENT_PORT=3000
LOG_LEVEL=INFO